.source-text{white-space:pre-wrap;font:14px/1.85 var(--serif);padding:23px;background:var(--bg);border:1px solid var(--border);border-radius:10px;margin-top:18px;max-height:430px;overflow:auto;overflow-wrap:anywhere}.source-text mark{background:#c8dfb747;color:var(--text)}.version-item{padding:14px;border:1px solid var(--border);border-radius:9px;display:flex;gap:15px;align-items:center;justify-content:space-between;margin-top:10px}.version-item small{display:block;color:var(--muted);font-size:10px}.export-options{display:grid;grid-template-columns:1fr 1fr;gap:12px}.export-card{padding:20px;background:var(--bg);border:1px solid var(--border);border-radius:9px;color:var(--text);text-align:left}.export-card:hover{border-color:var(--accent)}.export-card strong{display:block;margin:10px 0 3px;font-size:13px}.export-card small{color:var(--muted);font-size:11px}#toasts{position:fixed;right:23px;bottom:23px;z-index:100;display:grid;gap:10px;max-width:480px}.toast{padding:13px 18px;border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow);background:var(--panel2);font-size:12px;display:flex;align-items:flex-start;gap:12px;animation:appear .2s ease}.toast.error{border-color:var(--red)}.toast .icon{color:var(--accent);margin-top:1px}.toast.error .icon{color:var(--red)}@keyframes appear{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}.keyboard{border:1px solid var(--border);font-size:9px;border-radius:4px;padding:1px 5px;color:var(--soft)}.error-inline{color:var(--red);font-size:12px;padding:10px 0;line-height:1.6}.modal-status{font-size:11px;color:var(--muted);margin-right:auto}.toolbar .icon{width:16px;height:16px}.details-line{font-size:11px;color:var(--muted);padding:5px 0;display:flex;justify-content:space-between;gap:12px}.measure{height:4px;background:var(--border);margin-top:4px;border-radius:3px;overflow:hidden}.measure i{display:block;height:100%;background:var(--accent)}.mobile-menu{display:none}
@media(min-width:1600px){.two-pane,.writing-layout{grid-template-columns:minmax(0,1fr) 310px}.graph-canvas{height:590px}.graph-panel{min-height:610px}.workspace-head{padding-top:36px}}
@media(max-width:1200px){.shell{grid-template-columns:195px minmax(0,1fr)}.sidebar{padding:24px 13px 16px}.topbar{padding:0 24px}.workspace-head{padding:24px}.workspace-head h1{font-size:25px}.steps{padding:0 24px 20px}.workspace-body{padding:0 24px 25px}.job-bar{margin:0 24px 20px}.two-pane,.writing-layout{grid-template-columns:minmax(0,1fr) 252px;gap:14px}.source-grid{grid-template-columns:1fr}.graph-bar{left:12px;right:12px}.graph-search{max-width:215px}.header-actions{gap:8px}.graph-node text{font-size:12px}.manuscript,.prose{padding:25px}.step-rule{width:14px}}
@media(max-width:980px){.two-pane,.writing-layout{grid-template-columns:1fr}.direction-panel{display:grid;grid-template-columns:1fr}.graph-panel{min-height:500px}.graph-canvas{height:490px}.side-bottom .side-note{display:none}.workspace-head{align-items:flex-start}.workspace-head .header-actions{flex-direction:column;align-items:flex-end}.source-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:720px){.shell{grid-template-columns:1fr}.sidebar{display:none}.sidebar.open{display:flex;position:fixed;top:0;left:0;z-index:20;width:225px;box-shadow:var(--shadow)}.mobile-menu{display:inline-flex}.topbar{padding:0 16px;height:58px}.topbar .saved{display:none}.workspace-head{padding:23px 16px 17px}.workspace-head h1{font-size:22px}.workspace-head .description{max-width:260px}.workspace-head .header-actions{display:none}.workspace-body{padding:0 16px 24px}.steps{padding:0 16px 17px;gap:7px}.step{font-size:10px;gap:5px}.step-rule{width:9px}.job-bar{margin:0 16px 17px}.source-grid{grid-template-columns:1fr}.welcome{padding:35px 22px}.welcome h1{font-size:38px}.welcome-grid{grid-template-columns:1fr}.welcome-end{flex-wrap:wrap}.outline-fields{grid-template-columns:1fr;margin-left:0}.outline-foot{margin-left:0}.toolbar{align-items:flex-start;flex-wrap:wrap}.form-grid{grid-template-columns:1fr}.form-full{grid-column:auto}.modal-backdrop{padding:12px}.modal-head,.modal-body,.modal-foot{padding:17px}.editor-area.split{grid-template-columns:1fr}.editor-area.split .prose{border-top:1px solid var(--border)}.graph-search{max-width:190px}.graph-caption{max-width:90%}.graph-footer{font-size:9px}.graph-footer>.muted{display:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media print{.sidebar,.topbar,.workspace-head,.steps,.editor-toolbar,.editor-foot,.direction-panel,.toolbar,.job-bar{display:none!important}.shell,.writing-layout,.editor-area{display:block}.workspace-body{padding:0}.manuscript{display:none}.prose{display:block!important;color:#222;background:white}.panel{border:none;background:white}.prose .citation{color:#222}.modal-backdrop{display:none}}
/* Fine details keep the workspace calm at narrow sizes. */
.brand{text-decoration:none}.brand strong{color:var(--text)}.brand small{max-width:140px;line-height:1.45}.project-list{min-width:0}.project-item{min-width:0;overflow:hidden}.project-name{min-width:0;flex:1}.project-name small{display:block;font-size:9px;color:var(--soft);margin-top:2px}.saved{display:flex;align-items:center;gap:6px}.saved .icon{width:13px;height:13px}.range-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px;font-size:11px}.range-row label{margin:0;font-size:11px;font-weight:400}.section-title{font-size:15px;letter-spacing:-.02em}.pin{display:inline-flex;align-items:center;gap:4px}.pin .icon{width:11px;height:11px}.graph-node .outer{fill:currentColor;opacity:.04}.graph-node.active .outer{fill:var(--accent);stroke:var(--accent);opacity:.3}
main{min-width:0}.two-pane>div,.workspace-head>div{min-width:0}
@media(max-width:720px){.steps{gap:4px;justify-content:space-between}.step{font-size:9.5px;gap:4px}.step-rule{width:5px;flex-shrink:1}.workspace-head .caps{overflow-wrap:anywhere}.workspace-head>div>.row{flex-wrap:wrap}.graph-canvas{height:330px}.graph-panel{min-height:355px}.graph-bar{gap:5px}.graph-controls{gap:0}.graph-search{min-width:0}.legend{gap:7px}#toasts{left:16px;right:16px;max-width:none}.source-card{min-width:0}.angle-foot{flex-wrap:wrap}}
