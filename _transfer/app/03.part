function outlineHTML(){const p=state.p;if(!p.outline.length)return empty('A shape before the sentences.','Select an angle first. The outline will connect each section or scene to its purpose and source material.','Develop outline','run-outline','list');const a=selectedAngle();return `<div class="toolbar"><div><h2 class="section-title">${esc(a?.title||'Working outline')}</h2><p class="section-desc">${p.outline.length} ${p.mode==='fiction'?'scenes':'sections'} · ${fmt(p.outline.reduce((n,s)=>n+s.target_words,0))} planned words</p></div>${btn('Add section','add-section','plus','small',busy()?'disabled':'')}</div><div class="outline-list">${p.outline.map((s,i)=>`<article class="outline-section" data-section="${esc(s.id)}"><div class="section-heading"><span class="outline-number">${String(i+1).padStart(2,'0')}</span><input aria-label="Section ${i+1} title" data-outline="title" data-id="${esc(s.id)}" value="${esc(s.title)}" ${busy()?'disabled':''}><div class="row">${ibtn('Move up','move-section','up',`data-id="${esc(s.id)}" data-offset="-1" ${i===0?'disabled':''}`)}${ibtn('Move down','move-section','down',`data-id="${esc(s.id)}" data-offset="1" ${i===p.outline.length-1?'disabled':''}`)}${ibtn('Remove section','remove-section','x',`data-id="${esc(s.id)}"`)}</div></div><div class="outline-fields"><div><label>What changes here?</label><textarea data-outline="purpose" data-id="${esc(s.id)}" rows="3" ${busy()?'disabled':''}>${esc(s.purpose)}</textarea></div><div class="beats"><label>Beats / key points · one per line</label><textarea data-outline="beats" data-id="${esc(s.id)}" rows="3" ${busy()?'disabled':''}>${esc(s.beats.join('\n'))}</textarea></div></div><div class="outline-foot"><div class="row wrap">${s.source_ids.map(id=>btn(id,'source','file','small ghost',`data-id="${esc(id)}"`)).join('')||'<span class="tiny muted">No source assigned</span>'}</div><label class="row tiny muted">Words <input class="words-input" type="number" min="50" max="5000" data-outline="target_words" data-id="${esc(s.id)}" value="${s.target_words}" ${busy()?'disabled':''}></label></div></article>`).join('')}</div><div class="row mt20 wrap">${btn('Write draft','run-draft','pen','primary',busy()?'disabled':'')}${btn('Regenerate outline','run-outline','refresh','ghost small',busy()?'disabled':'')}<span class="tiny muted">Sections are written sequentially, then reviewed as a whole.</span></div>`;}
function inlineMD(t){return esc(t).replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/\*([^*\n]+)\*/g,'<em>$1</em>').replace(/\[(S\d+)\]/g,'<button class="citation" data-action="source" data-id="$1">[$1]</button>');}
function markdown(text){return String(text||'').split(/\n\s*\n/).map(block=>{const lines=block.split('\n');if(/^#{1,3} /.test(lines[0])){const m=lines[0].match(/^(#{1,3}) (.*)$/);return `<h${m[1].length}>${inlineMD(m[2])}</h${m[1].length}>`+(lines.length>1?'<p>'+lines.slice(1).map(inlineMD).join('<br>')+'</p>':'');}if(/^\s*(\*\s*\*\s*\*|---)\s*$/.test(block))return '<hr>';if(lines.every(l=>/^[-*] /.test(l)))return '<ul>'+lines.map(l=>'<li>'+inlineMD(l.slice(2))+'</li>').join('')+'</ul>';if(lines.every(l=>/^\d+\. /.test(l)))return '<ol>'+lines.map(l=>'<li>'+inlineMD(l.replace(/^\d+\. /,''))+'</li>').join('')+'</ol>';if(/^> /.test(block))return '<blockquote>'+inlineMD(block.replace(/^> /gm,''))+'</blockquote>';return '<p>'+lines.map(inlineMD).join('<br>')+'</p>';}).join('');}
function writeHTML(){const p=state.p;return `<div class="writing-layout"><div class="panel"><div class="editor-toolbar"><div class="segmented" aria-label="Editor view">${['write','split','preview'].map(v=>`<button class="${state.view===v?'active':''}" data-action="editor-view" data-view="${v}">${v[0].toUpperCase()+v.slice(1)}</button>`).join('')}</div><div class="row">${ibtn('Version history','versions','clock')}${ibtn('Export draft','export','download')}</div></div><div class="editor-area ${state.view==='split'?'split':''}">${state.view!=='preview'?`<textarea class="manuscript" id="manuscript" aria-label="Manuscript editor" spellcheck="true" placeholder="Start writing here. Or develop your outline and let your model create the first draft." ${busy()?'readonly':''}>${esc(p.draft)}</textarea>`:''}${state.view!=='write'?`<article class="prose" id="draft-preview">${p.draft?markdown(p.draft):'<p class="muted">Your words, with room to breathe.</p>'}</article>`:''}</div><div class="editor-foot"><span id="word-count">${fmt(words(p.draft))} words · target ${fmt(p.brief.target_words)}</span><span><kbd class="keyboard">Ctrl S</kbd> save · Markdown supported</span></div></div><aside class="panel direction-panel"><div class="panel-header"><h2 class="section-title">Editorial desk</h2>${icon('pen')}</div><div class="panel-body"><div class="stack">${btn('Review the draft','run-review','check','primary',busy()||!p.draft?'disabled':'')}${btn('Revise with a direction','revise-dialog','pen','',busy()||!p.draft?'disabled':'')}${btn('Draft from outline','run-draft','spark','ghost small',busy()?'disabled':'')}</div>${reviewHTML()}<div class="evidence-card mt20"><span class="caps">Your own voice</span><p class="hint">Add a voice sample in Sources. It guides cadence and diction—not recycled sentences.</p>${btn('Edit creative brief','brief','settings','small ghost')}${p.mode==='fiction'?btn('Story ledger','story-ledger','book','small ghost'):''}</div><div class="mt20 tiny muted">${fmt(p.usage.calls)} provider calls · ${fmt(p.usage.input_tokens+p.usage.output_tokens)} tokens<br>${Number(p.usage.reported_cost||0)>0?'$'+Number(p.usage.reported_cost).toFixed(4)+' reported cost':'Cost unavailable for unpriced calls'}${p.usage.unpriced_calls?'<br>'+p.usage.unpriced_calls+' calls without provider-reported cost':''}</div></div></aside></div>`;}
function reviewHTML(){const r=state.p.review;if(!r?.summary)return '<div class="notice">The review checks argument and evidence in nonfiction; motivation, scene craft and canon in fiction. It is a second opinion—not a truth certificate.</div>';return `<div class="mt20"><span class="caps">Latest review</span><p class="small mt12">${esc(r.summary)}</p>${r.strengths.map(s=>`<p class="hint">✓ ${esc(s)}</p>`).join('')}${r.issues.map(i=>`<div class="review-issue"><span class="severity ${i.severity==='critical'?'critical':''}">${esc(i.severity||i.category||'Review')}</span><p>${esc(i.issue||i.description||i.problem||i.text||JSON.stringify(i))}</p>${i.quote||i.excerpt?`<blockquote>${esc(i.quote||i.excerpt)}</blockquote>`:''}${i.fix||i.suggestion?`<p>${esc(i.fix||i.suggestion)}</p>`:''}</div>`).join('')}${r.citation_audit?.sampled_claims?.length?`<details class="mt20"><summary class="small">Source-support check · ${r.citation_audit.sampled_claims.length} claims</summary>${r.citation_audit.sampled_claims.map(c=>`<div class="review-issue"><span class="severity">${esc(c.editor_judgment)}</span><p>${esc(c.claim)}</p>${c.quotes.map(q=>`<blockquote>${esc(q.quote)}</blockquote><button class="text-link" data-action="source" data-id="${esc(q.source_id)}">${esc(q.source_id)} · ${q.exact_match?'exact match':'not matched'}</button>`).join('')}</div>`).join('')}<p class="hint">Sampled claims only. A matching quote does not prove entailment.</p></details>`:''}<div class="notice">${esc(r.verdict||'Review available. Make the final editorial judgment yourself.')}<br>Reviews apply to the draft at the time they were run. Re-run after edits.</div></div>`;}
let graphView={x:0,y:0,k:1};
function drawGraph(){
 const svg=$('#graph-svg');if(!svg||!state.p)return;const g=state.p.graph;const search=state.search.toLowerCase();
 const focus=new Set(state.path);if(state.node){focus.add(state.node);g.edges.forEach(e=>{if(e.source===state.node)focus.add(e.target);if(e.target===state.node)focus.add(e.source);});}
 const degree={};g.edges.forEach(e=>{degree[e.source]=(degree[e.source]||0)+1;degree[e.target]=(degree[e.target]||0)+1;});
 let nodes=g.nodes.slice().sort((a,b)=>((focus.has(b.id)?10000:0)+(search&&b.label.toLowerCase().includes(search)?10000:0)+(degree[b.id]||0))-((focus.has(a.id)?10000:0)+(search&&a.label.toLowerCase().includes(search)?10000:0)+(degree[a.id]||0))).slice(0,180);
 const ids=new Set(nodes.map(n=>n.id)),edges=g.edges.filter(e=>ids.has(e.source)&&ids.has(e.target));
 if($('#graph-visibility'))$('#graph-visibility').textContent=g.nodes.length>180?` · showing ${nodes.length} most connected / matching nodes`:'';
 if(!Object.keys(state.layout).length){
  const positions={};nodes.forEach((n,i)=>{const angle=i*2.39996;const r=50+Math.sqrt(i/Math.max(nodes.length,1))*210;positions[n.id]={x:450+Math.cos(angle)*r*1.4,y:294+Math.sin(angle)*r};});
  for(let step=0;step<190;step++){
   const forces={};nodes.forEach(n=>forces[n.id]={x:(450-positions[n.id].x)*.018,y:(290-positions[n.id].y)*.018});
   for(let i=0;i<nodes.length;i++)for(let j=i+1;j<nodes.length;j++){const a=positions[nodes[i].id],b=positions[nodes[j].id];let dx=a.x-b.x,dy=a.y-b.y,d2=Math.max(150,dx*dx+dy*dy),f=11000/(d2*Math.sqrt(d2));forces[nodes[i].id].x+=dx*f;forces[nodes[i].id].y+=dy*f;forces[nodes[j].id].x-=dx*f;forces[nodes[j].id].y-=dy*f;}
   edges.forEach(e=>{const a=positions[e.source],b=positions[e.target],dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy)||1,f=(d-145)*.055;forces[e.source].x+=dx/d*f;forces[e.source].y+=dy/d*f;forces[e.target].x-=dx/d*f;forces[e.target].y-=dy/d*f;});
