   nodes.forEach(n=>{positions[n.id].x=Math.max(95,Math.min(805,positions[n.id].x+Math.max(-8,Math.min(8,forces[n.id].x))));positions[n.id].y=Math.max(90,Math.min(490,positions[n.id].y+Math.max(-8,Math.min(8,forces[n.id].y))));});
  }
  if(nodes.length>2){const xs=nodes.map(n=>positions[n.id].x),ys=nodes.map(n=>positions[n.id].y),minX=Math.min(...xs),minY=Math.min(...ys),dx=Math.max(1,Math.max(...xs)-minX),dy=Math.max(1,Math.max(...ys)-minY);nodes.forEach(n=>{positions[n.id].x=110+(positions[n.id].x-minX)/dx*680;positions[n.id].y=112+(positions[n.id].y-minY)/dy*352;});}
  for(let iteration=0;iteration<65;iteration++)for(let i=0;i<nodes.length;i++)for(let j=i+1;j<nodes.length;j++){const a=positions[nodes[i].id],b=positions[nodes[j].id],dx=a.x-b.x,dy=a.y-b.y,ox=(Math.min(30,nodes[i].label.length)+Math.min(30,nodes[j].label.length))*3+14-Math.abs(dx),oy=43-Math.abs(dy);if(ox>0&&oy>0){if(ox<oy*1.8){const d=Math.sign(dx)||1;a.x+=d*ox*.25;b.x-=d*ox*.25;}else{const d=Math.sign(dy)||1;a.y+=d*oy*.25;b.y-=d*oy*.25;}a.x=Math.max(100,Math.min(800,a.x));b.x=Math.max(100,Math.min(800,b.x));a.y=Math.max(100,Math.min(485,a.y));b.y=Math.max(100,Math.min(485,b.y));}}
  state.layout=positions;graphView={x:0,y:0,k:1};
 }
 nodes.forEach((n,i)=>{state.layout[n.id]||={x:120+(i%8)*90,y:110+Math.floor(i/8)*60};});
 const color=n=>['claim','character','person'].includes(n.kind)?'var(--blue)':['tension','conflict','event','risk','question'].includes(n.kind)?'var(--gold)':['canon','rule'].includes(n.kind)?'var(--purple)':'var(--accent)';
 svg.innerHTML=`<defs><marker id="arrowhead" viewBox="0 0 8 8" refX="18" refY="4" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 8 4 0 8" fill="var(--muted)"/></marker></defs><g id="graph-world" transform="translate(${graphView.x} ${graphView.y}) scale(${graphView.k})">${edges.map(e=>{const a=state.layout[e.source],b=state.layout[e.target];const hi=state.path.length?state.path.includes(e.source)&&state.path.includes(e.target):state.node&&(e.source===state.node||e.target===state.node);return `<g><line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" class="graph-edge ${['inferred','proposed','imported'].includes(e.status)?'inferred':''} ${hi?'highlight':focus.size?'dim':''}" marker-end="url(#arrowhead)"/><line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="transparent" stroke-width="13" data-edge="${esc(e.id)}" style="cursor:pointer"><title>${esc(e.relation)} · ${esc(e.status)}</title></line>${hi?`<text x="${(a.x+b.x)/2}" y="${(a.y+b.y)/2-5}" fill="var(--muted)" font-size="9" text-anchor="middle" style="paint-order:stroke;stroke:var(--panel);stroke-width:3px">${esc(e.relation.replaceAll('_',' '))}</text>`:''}</g>`;}).join('')}${nodes.map(n=>{const p=state.layout[n.id],r=8+Math.min(degree[n.id]||0,8)*.9,dim=(focus.size&&!focus.has(n.id))||(search&&!n.label.toLowerCase().includes(search));return `<g transform="translate(${p.x} ${p.y})" class="graph-node ${state.node===n.id?'active':''} ${dim?'dim':''}" data-node="${esc(n.id)}" role="button" tabindex="0" aria-label="${esc(n.label)}"><circle class="outer" r="${r+8}" fill="${color(n)}" opacity=".09"/><circle r="${r}" fill="${color(n)}" opacity=".93" stroke="var(--panel)" stroke-width="2"/>${state.p.brief.pinned_nodes.includes(n.id)?`<circle r="${r+5}" fill="none" stroke="${color(n)}" stroke-dasharray="2 3"/>`:''}<text y="${r+22}" text-anchor="middle" ${nodes.length>55&&!focus.has(n.id)&&!(search&&n.label.toLowerCase().includes(search))?'display="none"':''}>${esc(n.label.length>30?n.label.slice(0,28)+'…':n.label)}</text><title>${esc(n.description||n.label)}</title></g>`;}).join('')}</g>`;
 let drag=null,moved=false;
 const point=ev=>{const p=svg.createSVGPoint();p.x=ev.clientX;p.y=ev.clientY;return p.matrixTransform(svg.getScreenCTM().inverse());};
 svg.onpointerdown=ev=>{const p=point(ev),n=ev.target.closest('[data-node]'),ed=ev.target.closest('[data-edge]');if(ed)return;drag={id:n?.dataset.node,p,start:{...graphView}};moved=false;svg.setPointerCapture(ev.pointerId);};
 svg.onpointermove=ev=>{if(!drag)return;const p=point(ev);if(Math.hypot(p.x-drag.p.x,p.y-drag.p.y)>4)moved=true;if(!moved)return;if(drag.id){state.layout[drag.id]={x:(p.x-graphView.x)/graphView.k,y:(p.y-graphView.y)/graphView.k};const el=$(`[data-node="${CSS.escape(drag.id)}"]`,svg);el?.setAttribute('transform',`translate(${state.layout[drag.id].x} ${state.layout[drag.id].y})`);}else{graphView.x=drag.start.x+p.x-drag.p.x;graphView.y=drag.start.y+p.y-drag.p.y;$('#graph-world').setAttribute('transform',`translate(${graphView.x} ${graphView.y}) scale(${graphView.k})`);}};
 svg.onpointerup=()=>{if(!drag)return;const id=drag.id;drag=null;if(moved){drawGraph();return;}if(id)selectNode(id);};
 svg.onwheel=ev=>{ev.preventDefault();const p=point(ev),k=Math.max(.3,Math.min(3.5,graphView.k*(ev.deltaY<0?1.12:.89)));graphView.x=p.x-(p.x-graphView.x)*k/graphView.k;graphView.y=p.y-(p.y-graphView.y)*k/graphView.k;graphView.k=k;$('#graph-world').setAttribute('transform',`translate(${graphView.x} ${graphView.y}) scale(${k})`);};
 svg.onclick=ev=>{const e=ev.target.closest('[data-edge]');if(e){state.edge=e.dataset.edge;state.node=null;refreshDirection();}};
 svg.onkeydown=ev=>{const n=ev.target.closest('[data-node]');if(n&&['Enter',' '].includes(ev.key)){ev.preventDefault();selectNode(n.dataset.node);}};
}
function selectNode(id){state.node=id;state.edge=null;state.path=[];drawGraph();refreshDirection();}
function refreshDirection(){const e=$('.direction-panel');if(e)e.outerHTML=directionHTML();}
function paintJob(){const slot=$('#job-slot');if(!slot)return;const j=state.job;if(!j){slot.innerHTML='';return;}const msg=j.messages?.at(-1);slot.innerHTML=`<div class="job-bar"><div class="row">${busy()?'<span class="loader"></span>':icon(j.state==='completed'?'check':'alert')}<div class="spacer"><div class="job-message">${esc(typeof msg==='string'?msg:msg?.text||j.action+' · '+j.state)}</div><div class="job-usage">${esc(j.state)} · ${fmt(j.usage?.calls)} calls · ${fmt((j.usage?.input_tokens||0)+(j.usage?.output_tokens||0))} tokens ${j.usage?.reported_cost?'· $'+Number(j.usage.reported_cost).toFixed(4)+' reported':''}${j.error?' · '+esc(j.error):''}</div></div>${busy()?btn('Cancel','cancel-job','stop','small ghost'):ibtn('Dismiss job result','dismiss-job','x')}</div><div class="progress"><i style="width:${Math.max(0,Math.min(100,Number(j.progress)||0))}%"></i></div></div>`;}
async function startJob(action,instruction=''){if(!editable())return;await flush();if(!state.settings.allow_cloud&&!['localhost','127.0.0.1','[::1]'].includes(new URL(state.settings.base_url).hostname)){toast('Connect your model and allow sending selected material before running AI actions.');showSettings();return;}if(!state.settings.model){toast('Choose a writing model in Connections first.');showSettings();return;}state.job=await api('/projects/'+state.p.id+'/jobs',{action,instruction});render();poll();}
function poll(){clearTimeout(pollTimer);if(!state.job)return;const jid=state.job.id,pid=state.p.id;pollTimer=setTimeout(async()=>{try{const j=await api('/jobs/'+jid);if(state.job?.id!==jid||state.p?.id!==pid)return;state.job=j;paintJob();if(['queued','running'].includes(j.state)){poll();return;}const p=await api('/projects/'+state.p.id);state.p=p;syncSummary();if(j.state==='completed'){state.tab={graph:'graph',angles:'angles',outline:'outline',draft:'write',review:'write',revise:'write'}[j.action]||state.tab;state.layout={};toast('Finished. Your project is saved locally.');}else toast(j.error||'Job stopped. Saved versions are still available.',j.state==='failed');render();}catch(e){toast(e.message,true);poll();}},1000);}
function newDialog(mode='nonfiction'){showModal('Begin a new project','You can change the direction as the work develops.',`<div class="form-grid"><div class="form-full"><label for="project-title">Project title</label><input id="project-title" placeholder="A working title is enough" maxlength="200"></div><div><label for="project-mode">Writing mode</label><select id="project-mode"><option value="nonfiction" ${mode==='nonfiction'?'selected':''}>Nonfiction — evidence & argument</option><option value="fiction" ${mode==='fiction'?'selected':''}>Fiction — characters & consequences</option></select></div><div><label for="project-words">Target length</label><input id="project-words" type="number" value="1800" min="200" max="20000"></div><div class="form-full"><label for="project-premise">What is on your mind?</label><textarea id="project-premise" rows="4" placeholder="A question, a premise, an argument you want to explore…"></textarea></div></div>`,btn('Create project','create-project','arrow','primary'));}
function rolesHTML(value){return ['evidence','canon','inspiration','voice'].map(v=>`<option value="${v}" ${v===value?'selected':''}>${v[0].toUpperCase()+v.slice(1)}</option>`).join('');}
