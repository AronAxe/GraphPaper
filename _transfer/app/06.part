function showSettings(){showModal('Connections & settings','Bring your models. Keep your manuscripts local.',settingsForm(),btn('Save connections','save-settings','check','primary'),true);}
async function saveSettings(){const s={...state.settings};for(const k of ['provider','base_url','model','editor_model','extraction_model','jev_provider','jev_model','graph_engine','graphify_executable'])s[k]=$('#s-'+k).value.trim();for(const k of ['max_calls','max_output_tokens','context_chars','max_candidates'])s[k]=Number($('#s-'+k).value);for(const k of ['allow_cloud','remember_keys','refine'])s[k]=$('#s-'+k).checked;s.api_keys={};for(const k of ['llm','openrouter','typesafe'])s.api_keys[k]=$('#key-'+k).value||null;state.settings=await api('/settings',s,'PUT');$('#modal-status').textContent='Saved. Keys are not returned to the browser.';}
function chooseFile(accept,multiple,callback){const el=document.createElement('input');el.type='file';el.accept=accept;el.multiple=multiple;el.onchange=()=>callback([...el.files]).catch(e=>toast(e.message,true));el.click();}
async function uploadFiles(files){if(!editable())return;await flush();let successes=0;for(const file of files){try{if(file.size>20*1024*1024)throw new Error(file.name+' exceeds 20 MB.');const form=new FormData();form.append('file',file);form.append('role',state.p.mode==='fiction'?'canon':'evidence');state.p=await api('/projects/'+state.p.id+'/sources/file',form);successes++;}catch(e){toast(file.name+': '+e.message,true);}}syncSummary();render();if(successes)toast(`${successes} source${successes===1?'':'s'} added.`);}
function setupDrops(){const el=$('#dropzone');if(!el)return;el.ondragover=e=>{e.preventDefault();el.classList.add('drag');};el.ondragleave=()=>el.classList.remove('drag');el.ondrop=e=>{e.preventDefault();el.classList.remove('drag');uploadFiles([...e.dataTransfer.files]).catch(e=>toast(e.message,true));};el.onkeydown=e=>{if(['Enter',' '].includes(e.key)){e.preventDefault();chooseFile('.pdf,.docx,.md,.txt,.html,.htm,.csv',true,uploadFiles);}};}
async function exportFile(kind){await flush();if(window.pywebview?.api?.save_export){const r=await window.pywebview.api.save_export(state.p.id,kind);if(r.error)throw new Error(r.error);if(r.saved)toast('Export saved.');return;}const res=await fetch(`/api/projects/${state.p.id}/export/${kind}`,{headers:{'X-GraphPaper':'1'},credentials:'same-origin'});if(!res.ok)throw new Error((await res.json()).detail||'Export failed.');const data=await res.blob(),url=URL.createObjectURL(data),a=document.createElement('a');a.href=url;a.download=res.headers.get('Content-Disposition')?.match(/filename="([^"]+)"/)?.[1]||'GraphPaper.'+kind;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),10000);}
function exportDialog(){showModal('Let the work leave the studio','Export a draft or keep a portable copy of the entire project.',`<div class="export-options">${[['docx','Word document','Editable manuscript with bibliography','file'],['md','Markdown','Plain text with source references','pen'],['html','Print-ready HTML','Open in your browser to print or save as PDF','eye'],['json','Project backup','Sources, graph, angles, outline and current draft','folder'],['graph','Knowledge graph','Graph JSON for external tools','graph']].map(([kind,title,desc,ic])=>`<button class="export-card" data-action="export-file" data-kind="${kind}">${icon(ic)}<strong>${title}</strong><small>${desc}</small></button>`).join('')}</div><div class="notice">Project backups contain your source texts and current draft, but never API keys. Historical draft versions stay in the local database; export an earlier version by restoring it first.</div>`);}
async function versionsDialog(){await flush();const rows=await api('/projects/'+state.p.id+'/revisions');state.versions=rows;showModal('Versions, not regrets','Generated checkpoints and earlier drafts are kept separately.',`${rows.length?rows.map(r=>`<div class="version-item"><div><strong class="small">${esc(r.label)}</strong><small>${esc(new Date(r.created).toLocaleString())} · ${fmt(words(r.draft))} words</small></div><div class="row">${btn('Read','read-version','eye','small ghost',`data-id="${esc(r.id)}"`)}${btn('Restore','restore-version','clock','small',`data-id="${esc(r.id)}"`)}</div></div>`).join(''):'<p class="muted">Versions appear once you edit or generate a draft.</p>'}`,'',true);}
async function handleAction(el){const a=el.dataset.action,p=state.p,id=el.dataset.id;
 if(a?.startsWith('run-'))return startJob(a.slice(4));
 switch(a){
 case 'close-modal':closeModal();break;
 case 'menu':$('.sidebar').classList.toggle('open');break;
 case 'home':await flush();state.p=null;render();break;
 case 'new':newDialog(el.dataset.mode||'nonfiction');break;
 case 'create-project':{const title=$('#project-title').value.trim()||'Untitled project',mode=$('#project-mode').value,w=Number($('#project-words').value),direction=$('#project-premise').value;if(w<200||w>20000)throw new Error('Choose 200–20,000 target words.');let n=await api('/projects',{title,mode});n=await api('/projects/'+n.id,{version:n.version,brief:{...n.brief,target_words:w,direction}},'PATCH');closeModal();await setProject(n,'sources');break;}
 case 'demo':{const n=await api('/demo',{mode:el.dataset.mode||'nonfiction'});await setProject(n,'graph');break;}
 case 'open-project':await openProject(id);break;
 case 'tab':await flush();state.tab=el.dataset.tab;render();break;
 case 'theme':state.settings.theme=state.settings.theme==='light'?'dark':'light';state.settings=await api('/settings',state.settings,'PUT');document.documentElement.dataset.theme=state.settings.theme;break;
 case 'settings':await flush();showSettings();break;
 case 'save-settings':await saveSettings();closeModal();render();toast('Connections saved.');break;
 case 'load-models':await saveSettings();$('#modal-status').textContent='Loading model IDs…';{const out=await api('/models');const list=Array.isArray(out)?out:out.models||[];$('#model-list').innerHTML=list.map(m=>`<option value="${esc(typeof m==='string'?m:m.id)}"></option>`).join('');$('#modal-status').textContent=`${list.length} models loaded. Type in a model field to choose.`;}break;
 case 'test-writer':case 'test-jev':await saveSettings();$('#modal-status').textContent='Testing…';{const r=await api('/test-connection',{kind:a==='test-jev'?'jev':'writer'});$('#modal-status').textContent=r.message;}break;
 case 'clear-keys':{state.settings=await api('/settings',{...state.settings,api_keys:{llm:'',openrouter:'',typesafe:''}},'PUT');showSettings();toast('Saved keys cleared for this session and secure store.');break;}
 case 'brief':if(editable())briefDialog();break;
 case 'save-brief':{const b={...p.brief};for(const k of ['audience','format','direction','voice','genre','pov','tense','canon','avoid'])if($('#b-'+k))b[k]=$('#b-'+k).value;b.target_words=Number($('#b-target_words').value);if(b.target_words<200||b.target_words>20000)throw new Error('Choose 200–20,000 words.');p.brief=b;queueSave({brief:b});await flush();closeModal();render();break;}
 case 'upload':chooseFile('.pdf,.docx,.md,.txt,.html,.htm,.csv',true,uploadFiles);break;
 case 'paste':if(editable())pasteDialog();break;
 case 'url':if(editable())urlDialog();break;
 case 'add-text':await flush();{const r=await api('/projects/'+p.id+'/sources/text',{title:$('#source-title').value||'Pasted source',text:$('#source-body').value,role:$('#source-role').value,url:$('#source-url').value,author:$('#source-author').value});state.p=r;syncSummary();closeModal();render();toast('Source added.');}break;
 case 'add-url':{await flush();$('#modal-status').textContent='Fetching article…';el.disabled=true;try{state.p=await api('/projects/'+p.id+'/sources/url',{url:$('#url-input').value,role:$('#source-role').value});syncSummary();closeModal();render();toast('Article imported.');}finally{el.disabled=false;}break;}
 case 'source':sourceDialog(id);break;
 case 'source-toggle':if(editable()){await flush();const s=p.sources.find(s=>s.id===id);state.p=await api('/projects/'+p.id+'/sources/'+id,{enabled:!s.enabled},'PATCH');render();}break;
 case 'save-source-role':if(editable()){await flush();const s=$('#change-role');state.p=await api('/projects/'+p.id+'/sources/'+s.dataset.id,{role:s.value},'PATCH');closeModal();render();}break;
 case 'evidence':{const item=p.graph.nodes.find(n=>n.id===state.node)||p.graph.edges.find(e=>e.id===state.edge);const ev=item?.evidence[Number(el.dataset.index)];if(ev)sourceDialog(ev.source_id,ev);break;}
 case 'pin':case 'unpin':case 'exclude':case 'clear-exclusions':if(editable()){const b={...p.brief};if(a==='pin')b.pinned_nodes=[...new Set([...b.pinned_nodes,id])];if(a==='unpin')b.pinned_nodes=b.pinned_nodes.filter(x=>x!==id);if(a==='exclude'){b.excluded_nodes=b.excluded_nodes.includes(id)?b.excluded_nodes.filter(x=>x!==id):[...b.excluded_nodes,id];b.pinned_nodes=b.pinned_nodes.filter(x=>x!==id);}if(a==='clear-exclusions')b.excluded_nodes=[];p.brief=b;queueSave({brief:b});refreshDirection();if(state.tab==='graph')drawGraph();}break;
 case 'zoom-in':case 'zoom-out':{const k=Math.min(3.5,Math.max(.3,graphView.k*(a==='zoom-in'?1.2:.8)));graphView.x=450-(450-graphView.x)*k/graphView.k;graphView.y=295-(295-graphView.y)*k/graphView.k;graphView.k=k;drawGraph();break;}
 case 'fit-graph':graphView={x:0,y:0,k:1};drawGraph();break;
