:root{--bg:#101714;--side:#141e19;--panel:#18231d;--panel2:#1d2a22;--hover:#243329;--border:#2c3b30;--text:#e8ece4;--muted:#92a192;--soft:#687d6c;--accent:#c7e1b9;--accentInk:#213722;--gold:#d6bd8b;--blue:#93bdc4;--purple:#b4a7c8;--red:#e6a294;--shadow:0 20px 65px #0005;--serif:Georgia,'Times New Roman',serif;--font:'Segoe UI',system-ui,-apple-system,BlinkMacSystemFont,sans-serif}
[data-theme=light]{--bg:#f4f4ed;--side:#ecefe5;--panel:#fcfcf7;--panel2:#eef1e8;--hover:#e4eadc;--border:#d8dfd0;--text:#263c2c;--muted:#687667;--soft:#869180;--accent:#385b3b;--accentInk:#f8faf4;--gold:#9c7839;--blue:#387986;--purple:#86749e;--red:#b75342;--shadow:0 20px 65px #24321f16}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 var(--font)}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.4;cursor:not-allowed}button,a,input,select,textarea{outline-offset:4px}button:focus-visible,a:focus-visible{outline:2px solid var(--accent)}a{color:var(--accent)}button{border:0}svg{display:block}input,textarea,select{color:var(--text);background:var(--bg);border:1px solid var(--border);border-radius:9px;padding:10px 12px;min-width:0;outline:none}input:focus,textarea:focus,select:focus{border-color:var(--accent)}textarea{resize:vertical;width:100%;min-height:85px}label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px;font-weight:550}h1,h2,h3,p{margin:0}h1,h2,h3{font-weight:550;letter-spacing:-.035em}h1{font-size:35px;line-height:1.16}h2{font-size:25px;line-height:1.25}h3{font-size:17px}.small{font-size:12px}.tiny{font-size:10px}.muted{color:var(--muted)}.accent{color:var(--accent)}.caps{text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:650;color:var(--muted)}.row{display:flex;align-items:center;gap:10px}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.stack{display:grid;gap:15px}.spacer{flex:1}.gap4{gap:4px}.mt12{margin-top:12px}.mt20{margin-top:20px}.mt28{margin-top:28px}.hidden{display:none!important}.icon{width:18px;height:18px;flex-shrink:0}.button{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;background:var(--panel2);color:var(--text);padding:10px 15px;white-space:nowrap;min-height:39px;font-size:12px;font-weight:600;border:1px solid var(--border);transition:.15s}.button:hover{background:var(--hover);border-color:var(--soft)}.button.primary{background:var(--accent);color:var(--accentInk);border-color:var(--accent)}.button.primary:hover{filter:brightness(1.06)}.button.ghost{background:transparent;border-color:transparent}.button.subtle{background:transparent}.button.small{padding:6px 10px;min-height:31px;font-size:11px}.icon-btn{padding:7px;min-width:32px;min-height:32px;display:inline-flex;align-items:center;justify-content:center;border-radius:7px;background:transparent;color:var(--muted);border:1px solid transparent}.icon-btn:hover{color:var(--text);background:var(--hover);border-color:var(--border)}.danger{color:var(--red)!important}.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:30px;padding:4px 9px;font-size:10px;font-weight:550;color:var(--muted);white-space:nowrap}.chip.gold{border-color:#d6bd8b38;color:var(--gold);background:#d6bd8b08}.chip.green{background:#acc68b10;color:var(--accent)}.dot{height:6px;width:6px;border-radius:50%;display:inline-block;background:var(--accent)}.divider{height:1px;background:var(--border);margin:20px 0}.shell{display:grid;grid-template-columns:224px minmax(0,1fr);min-height:100vh}.sidebar{height:100vh;position:sticky;top:0;background:var(--side);border-right:1px solid var(--border);padding:28px 18px 18px;display:flex;flex-direction:column;overflow:auto}.brand{display:flex;align-items:center;gap:11px;padding:0 5px;margin-bottom:25px}.brand img{width:35px;height:35px}.brand strong{font-size:21px;letter-spacing:-.055em;font-weight:550}.brand small{display:block;font-size:10px;color:var(--muted);margin-top:0}.sidebar .new{width:100%;margin-bottom:27px}.project-list{margin:12px 0 23px;display:grid;gap:5px;max-height:250px;overflow:auto}.project-item{display:flex;align-items:center;gap:9px;padding:10px 9px;border-radius:8px;text-align:left;color:var(--muted);background:transparent;width:100%;font-size:12px;border:1px solid transparent}.project-item.active{background:var(--panel2);color:var(--text);border-color:var(--border)}.project-item:hover{background:var(--hover)}.project-item .project-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.project-letter{width:25px;height:28px;border:1px solid var(--border);display:grid;place-items:center;font:13px var(--serif);color:var(--accent);border-radius:4px;flex-shrink:0}.nav-section{display:grid;gap:4px;margin:12px 0}.nav-link{display:flex;align-items:center;gap:11px;width:100%;padding:11px 12px;background:transparent;color:var(--muted);border-radius:7px;text-align:left;font-size:12px;position:relative}.nav-link.active{color:var(--accent);background:#aecf9b12}.nav-link.active:before{content:'';height:16px;width:2px;background:var(--accent);position:absolute;left:0;border-radius:4px}.nav-link:hover{background:var(--hover)}.nav-count{margin-left:auto;color:var(--soft);font-size:10px}.side-bottom{margin-top:auto;padding-top:25px}.side-note{padding:14px 12px;border:1px solid var(--border);border-radius:9px;margin-bottom:10px;font-size:11px;color:var(--muted);line-height:1.6}.side-note strong{color:var(--text);display:block;margin-bottom:4px;font-size:12px;font-weight:500}.main{min-width:0}.topbar{height:69px;border-bottom:1px solid var(--border);padding:0 34px;display:flex;align-items:center;justify-content:space-between;gap:20px}.breadcrumb{font-size:11px;color:var(--muted);display:flex;gap:9px;align-items:center}.header-actions{display:flex;align-items:center;gap:14px}.saved{font-size:10px;color:var(--muted)}.workspace-head{padding:28px 34px 22px;display:flex;align-items:flex-end;gap:20px;justify-content:space-between}.workspace-head h1{font-size:28px;margin:5px 0 7px}.workspace-head .description{font-size:12px;color:var(--muted)}.steps{display:flex;align-items:center;padding:0 34px 22px;gap:12px}.step{background:transparent;color:var(--soft);display:flex;align-items:center;gap:7px;font-size:11px;padding:0}.step span{width:20px;height:20px;border:1px solid var(--border);border-radius:50%;display:grid;place-items:center;font-size:9px}.step.active{color:var(--accent)}.step.active span{border-color:var(--accent);background:#b8dba214}.step.done{color:var(--muted)}.step-rule{width:30px;height:1px;background:var(--border)}.workspace-body{padding:0 34px 30px}.two-pane{display:grid;grid-template-columns:minmax(0,1fr) 282px;gap:20px}.panel{background:var(--panel);border:1px solid var(--border);border-radius:13px;overflow:hidden}.panel-header{padding:17px 19px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--border)}.panel-header h3{font-size:14px;letter-spacing:-.02em}.panel-body{padding:20px}.graph-panel{position:relative;min-height:550px;background-color:var(--panel);background-image:radial-gradient(var(--border) .65px,transparent .65px);background-size:19px 19px}.graph-bar{display:flex;align-items:center;gap:10px;position:absolute;left:18px;right:18px;top:16px;z-index:2}.graph-search{position:relative;flex:1;max-width:280px}.graph-search input{width:100%;padding:9px 12px 9px 35px;font-size:11px;background:var(--side)}.graph-search .icon{position:absolute;left:11px;top:10px;width:15px;height:15px;color:var(--muted)}.graph-controls{display:flex;gap:3px;background:var(--side);border:1px solid var(--border);padding:2px;border-radius:8px}.graph-controls .icon-btn{min-width:27px;width:27px;height:29px;padding:5px}.graph-canvas{width:100%;height:530px;display:block;touch-action:none;cursor:grab}.graph-canvas:active{cursor:grabbing}.graph-edge{stroke:var(--soft);stroke-opacity:.42;stroke-width:1.2;cursor:pointer;transition:opacity .18s}.graph-edge.inferred{stroke-dasharray:4 4}.graph-edge.highlight{stroke:var(--accent);stroke-width:2.1;stroke-opacity:.95}.graph-edge.dim{opacity:.15}.graph-node{cursor:pointer;outline:none}.graph-node circle{transition:stroke-width .15s,opacity .15s}.graph-node text{fill:var(--text);font:11px var(--font);paint-order:stroke;stroke:var(--panel);stroke-width:4px;stroke-linejoin:round}.graph-node .outer{fill:transparent;stroke-width:1;opacity:.3}.graph-node.active .outer{stroke-width:2;opacity:.95}.graph-node.dim{opacity:.18}.graph-node:focus-visible .outer{stroke:var(--accent);stroke-width:3;opacity:1}.graph-footer{position:absolute;left:18px;right:18px;bottom:17px;display:flex;justify-content:space-between;align-items:flex-end;gap:15px;font-size:10px;color:var(--muted);pointer-events:none}.legend{display:flex;flex-wrap:wrap;gap:11px}.legend span{display:flex;gap:5px;align-items:center}.legend i{width:6px;height:6px;border-radius:50%;display:block}.graph-caption{position:absolute;bottom:48px;left:18px;max-width:60%;font-size:10px;color:var(--soft)}.direction-panel{height:fit-content}.direction-panel .panel-body{padding:17px}.direction-label{font-size:11px;margin-bottom:9px}.direction-panel textarea{min-height:125px;font-size:12px;line-height:1.7;background:var(--bg)}.range-row{margin-top:19px}.range-row .between{font-size:11px;margin-bottom:7px;color:var(--muted)}