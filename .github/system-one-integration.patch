+            else:
+                keys=list(map(str,range(len(q['criteria']))))
+                answers[k]={'type':'score','score':len(keys)-1,'legend':dict(zip(keys,q['criteria'])),'probabilities':{v:float(v==keys[-1]) for v in keys},'confidence':1}
