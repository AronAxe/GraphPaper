function pasteDialog(){showModal('Bring a source into the studio','Keep the original text. The graph will link its claims back to these passages.',`<div class="form-grid"><div><label>Source title</label><input id="source-title" placeholder="Article, notes or chapter title"></div><div><label>Use as</label><select id="source-role">${rolesHTML(state.p.mode==='fiction'?'canon':'evidence')}</select></div><div class="form-full"><label>Source text</label><textarea class="long-text" id="source-body" placeholder="Paste the full text…"></textarea></div><div><label>Original URL (optional)</label><input id="source-url" type="url"></div><div><label>Author (optional)</label><input id="source-author"></div></div>`,btn('Add source','add-text','plus','primary'),true);}
function urlDialog(){showModal('Import from the web','Fetches a public page once. No account, cookies or paywall bypass.',`<label>Article URL</label><input id="url-input" type="url" placeholder="https://…" style="width:100%"><label class="mt12">Use as</label><select id="source-role">${rolesHTML('evidence')}</select><div class="notice">Some sites block automated access. Paste the article or upload a document instead when that happens. This action contacts the website, but does not send its content to an AI model.</div>`,btn('Import article','add-url','download','primary'));}
function sourceDialog(id,ev){const s=state.p.sources.find(s=>s.id===id);if(!s){toast('Source not found in this project.',true);return;}let text=esc(s.text);if(ev?.verified&&ev.start>=0)text=esc(s.text.slice(0,ev.start))+'<mark id="source-highlight">'+esc(s.text.slice(ev.start,ev.end))+'</mark>'+esc(s.text.slice(ev.end));showModal(s.title,`${s.id} · ${fmt(words(s.text))} words · ${s.kind}`,`<div class="row wrap"><span class="chip">${esc(s.role)}</span><span class="tiny muted">${esc(s.author)} ${esc(s.published)}</span></div>${s.url?`<p class="tiny muted mt12" style="overflow-wrap:anywhere">${esc(s.url)}</p>`:''}<div class="source-text">${text}</div>${s.warnings.map(w=>`<div class="notice">${esc(w)}</div>`).join('')}<div class="row mt20"><label for="change-role">Use as</label><select id="change-role" data-id="${esc(id)}">${rolesHTML(s.role)}</select></div>`,btn('Save role','save-source-role','check','primary'),true);setTimeout(()=>$('#source-highlight')?.scrollIntoView({block:'center'}),40);}
function briefDialog(){const b=state.p.brief,f=state.p.mode==='fiction';const field=(id,label,value,type='input')=>`<div class="${type==='textarea'?'form-full':''}"><label for="b-${id}">${esc(label)}</label>${type==='textarea'?`<textarea id="b-${id}" rows="3">${esc(value)}</textarea>`:`<input id="b-${id}" value="${esc(value)}">`}</div>`;showModal('The creative brief','Your intention is a first-class input—not an afterthought.',`<div class="form-grid">${field('audience','Audience',b.audience)}${field('format','Format',b.format)}${field('direction','Central question / direction',b.direction,'textarea')}${field('voice','Voice & style',b.voice,'textarea')}${f?field('genre','Genre',b.genre)+field('pov','Point of view',b.pov)+field('tense','Tense',b.tense)+field('canon','Canon / non-negotiable world rules',b.canon,'textarea'):''}${field('avoid','Avoid',b.avoid,'textarea')}<div><label>Target words</label><input id="b-target_words" type="number" min="200" max="20000" value="${b.target_words}"></div><div><label>Exploration / evidence discipline</label><p class="hint">${b.originality}% exploration · ${b.rigor}% discipline<br>Adjust the sliders beside the graph.</p></div></div>`,btn('Save brief','save-brief','check','primary'),true);}
function angleDialog(id){const a=state.p.angles.find(a=>a.id===id)||{id:uid(),title:'',thesis:'',hook:'',why:'',counterargument:'',questions:[],motif:'author',node_ids:[],edge_ids:[],source_ids:[],scores:{},decision:'author',score_engine:'author',score:null};state.editingAngle=a;showModal(id?'Refine this angle':'Your angle, your judgment','Say what this piece should do. You do not have to accept a model’s recommendation.',`<div class="form-grid"><div class="form-full"><label>Title</label><input id="a-title" value="${esc(a.title)}"></div><div class="form-full"><label>Thesis / premise</label><textarea id="a-thesis" rows="4">${esc(a.thesis)}</textarea></div><div class="form-full"><label>Opening hook</label><textarea id="a-hook" rows="2">${esc(a.hook)}</textarea></div><div class="form-full"><label>Strongest objection / central tension</label><textarea id="a-counter" rows="2">${esc(a.counterargument)}</textarea></div><div class="form-full"><label>Questions to resolve · one per line</label><textarea id="a-questions" rows="3">${esc(a.questions.join('\n'))}</textarea></div></div>`,btn('Save & select','save-angle','check','primary'),true);}
function settingsForm(){const s=state.settings;const opt=(v,label,current)=>`<option value="${v}" ${current===v?'selected':''}>${label}</option>`;const text=(id,label,val,attrs='')=>`<div><label for="s-${id}">${label}</label><input id="s-${id}" value="${esc(val)}" ${attrs}></div>`;return `<div class="form-grid"><div><label>Writing provider</label><select id="s-provider">${opt('openrouter','OpenRouter',s.provider)}${opt('openai-compatible','OpenAI-compatible / local',s.provider)}${opt('anthropic','Anthropic',s.provider)}</select></div>${text('base_url','API base URL',s.base_url)}${text('model','Writing model ID',s.model,'list="model-list" placeholder="Choose any model your provider supports"')}${text('editor_model','Editor model (blank = same)',s.editor_model,'list="model-list"')}${text('extraction_model','Extraction model (blank = same)',s.extraction_model,'list="model-list"')}<div><label>Model discovery</label>${btn('Load available models','load-models','refresh','small')}<datalist id="model-list"></datalist></div><div class="form-full"><label for="key-llm">Writing-provider key</label><input id="key-llm" type="password" autocomplete="new-password" placeholder="${s.keys?.llm?'Saved securely · leave blank to keep':'Paste key (not required for a keyless local server)'}"><span class="tiny muted">OpenRouter can also use the dedicated key below.</span></div><div><label>OpenRouter key (also used by JEV)</label><input id="key-openrouter" type="password" autocomplete="new-password" placeholder="${s.keys?.openrouter?'Saved securely · leave blank to keep':'Optional separate key'}"></div><div><label>TypeSafe key</label><input id="key-typesafe" type="password" autocomplete="new-password" placeholder="${s.keys?.typesafe?'Saved securely · leave blank to keep':'For direct JEV access'}"></div><div><label>JEV decision connection</label><select id="s-jev_provider">${opt('auto','Auto — OpenRouter, then TypeSafe',s.jev_provider)}${opt('openrouter','OpenRouter',s.jev_provider)}${opt('typesafe','Direct TypeSafe',s.jev_provider)}${opt('off','Off — structural exploration only',s.jev_provider)}</select></div>${text('jev_model','JEV model ID',s.jev_model)}<div class="form-full"><label class="checkbox-row"><input id="s-allow_cloud" type="checkbox" ${s.allow_cloud?'checked':''}><span><strong>Allow AI actions to send project material to my configured providers.</strong><br>Graph extraction, angle discovery, JEV decisions, drafting and review send the passages needed for that action. Never include confidential material without permission.</span></label><label class="checkbox-row"><input id="s-remember_keys" type="checkbox" ${s.remember_keys?'checked':''}><span>Remember keys using the operating system’s secure storage. Current storage: <strong>${esc(s.key_storage||'session only')}</strong>. No plaintext fallback.</span></label><label class="checkbox-row"><input id="s-refine" type="checkbox" ${s.refine?'checked':''}><span>After drafting, allow one bounded revision. Keep it only when the configured JEV check prefers it and citation checks pass; otherwise save it as a candidate version.</span></label></div></div><details class="mt20"><summary>Advanced limits & Graphify</summary><div class="form-grid mt20">${text('max_calls','Provider requests per job',s.max_calls,'type="number" min="5" max="500"')}${text('max_output_tokens','Maximum output tokens per call',s.max_output_tokens,'type="number" min="1000" max="64000"')}${text('context_chars','Context budget (characters, not tokens)',s.context_chars,'type="number" min="20000" max="1500000"')}${text('max_candidates','Graph candidates to judge',s.max_candidates,'type="number" min="6" max="80"')}<div><label>Graph engine</label><select id="s-graph_engine">${opt('native','Native evidence extraction',s.graph_engine)}${opt('graphify','Graphify + native evidence verification',s.graph_engine)}</select></div>${text('graphify_executable','Graphify executable (optional)',s.graphify_executable)}<div class="form-full notice">Graphify is optional and must be installed separately. Its subprocess makes its own model calls; those are not included in GraphPaper’s provider-request budget or token totals. You can also import a Graphify graph.json without running it.</div></div></details><div class="row mt12 wrap">${btn('Test writer','test-writer','check','small')}${btn('Test JEV','test-jev','check','small')}${btn('Clear saved keys','clear-keys','trash','small ghost')}<span class="tiny muted">Tests use a small provider request.</span></div><p class="tiny muted mt20" style="overflow-wrap:anywhere">Project storage: ${esc(s.data_directory)}</p>`;}
