 $('#app').innerHTML=`<div class="shell"><aside class="sidebar"><a class="brand" href="#" data-action="home"><img src="/static/icon.svg" alt=""><div><strong>GraphPaper</strong><small>A studio for connected thought</small></div></a>${btn('New project','new','plus','new')}<div class="caps">Your workspace</div><div class="project-list">${state.projects.map(x=>`<button class="project-item ${x.id===p?.id?'active':''}" data-action="open-project" data-id="${esc(x.id)}"><span class="project-letter">${icon(x.mode==='fiction'?'book':'file')}</span><span class="project-name">${esc(x.title)}<small>${x.mode==='fiction'?'Fiction':'Nonfiction'}</small></span></button>`).join('')||'<p class="side-note">Your stories and ideas live here.</p>'}</div>${p?`<div class="nav-section"><div class="caps">Studio</div>${steps.map(([t,label,ic])=>`<button class="nav-link ${state.tab===t?'active':''}" data-action="tab" data-tab="${t}">${icon(ic)}${label}<span class="spacer"></span>${t==='sources'?`<span class="nav-count">${p.sources.length}</span>`:t==='angles'&&p.angles.length?`<span class="nav-count">${p.angles.length}</span>`:''}</button>`).join('')}</div>`:''}<div class="side-bottom"><div class="side-note">${icon('lock')} Local projects. Your models.<br>Nothing leaves without your permission.</div><button class="nav-link" data-action="settings">${icon('settings')} Connections & settings</button><button class="nav-link" data-action="help">${icon('help')} How this studio works</button><div class="row between mt12"><span class="tiny muted">GraphPaper · 0.1.0</span>${ibtn('Switch theme','theme','sun')}</div></div></aside><main><header class="topbar"><div class="row">${'<button class="icon-btn mobile-menu" data-action="menu" aria-label="Menu">'+icon('menu')+'</button>'}<div class="breadcrumb">Studio ${p?`<span>/</span> ${esc(p.mode==='fiction'?'Fiction':'Nonfiction')}`:''}</div></div><div class="header-actions"><span class="saved">${icon('check')}${esc(state.save)}</span>${p?ibtn('Project options','project-options','settings'):''}${btn(p?'Export':'Import project',p?'export':'import-project',p?'download':'upload','small')}</div></header>${p?projectHTML():welcomeHTML()}</main></div>`;
 if(p&&state.tab==='graph'&&p.graph.nodes.length)requestAnimationFrame(drawGraph);
 setupDrops();paintJob();
}
function welcomeHTML(){return `<div class="welcome"><span class="chip green">${icon('graph')} FROM SOURCES TO SOMETHING NEW</span><h1>Good writing begins<br>with a connection.</h1><p>Bring your material. Find the relationships worth following. Shape an argument—or a world—and make it unmistakably yours.</p><div class="welcome-grid"><button class="panel welcome-card" data-action="new" data-mode="nonfiction">${icon('file')}<h3>Make a case.</h3><p>Essays, articles and research-led writing. Follow the evidence without losing your point of view.</p></button><button class="panel welcome-card" data-action="new" data-mode="fiction">${icon('book')}<h3>Build a world.</h3><p>Characters, tensions and consequences. Write fiction that remembers its own rules.</p></button></div><div class="welcome-end">Explore an example ${btn('The city after dark','demo','','small','data-mode="nonfiction"')}${btn('Borrowed mornings','demo','','small','data-mode="fiction"')}</div><div class="notice">The examples are original, illustrative workspaces—not factual research. Add a model connection to generate new writing; browsing, editing and exporting work without one.</div></div>`;}
function projectHTML(){const p=state.p;const names={sources:['A place for your material.','Add evidence, inspiration, a voice sample or the rules of your world.'],graph:['The connections are the beginning.','Explore the shape of your material. Pin what matters. Find a different way through.'],angles:['Find the story worth telling.','Different interpretations, not six versions of the same headline. You make the final choice.'],outline:['Give the idea a backbone.','Move the sections. Change the emphasis. Make the structure serve the writing.'],write:['Make every sentence earn its place.','Write, revise and check the work. Every generated draft has a recoverable version.']};const [title,desc]=names[state.tab];
 const primary={sources:['Build graph','run-graph','graph'],graph:['Discover angles','run-angles','spark'],angles:['Develop outline','run-outline','list'],outline:['Write draft','run-draft','pen'],write:['Review draft','run-review','check']}[state.tab];
 return `<div class="workspace-head"><div><div class="row gap4"><span class="caps">${esc(p.title)}</span>${p.demo?'<span class="chip gold">Illustrative example</span>':''}</div><h1>${title}</h1><p class="description">${desc}</p></div><div class="header-actions">${btn('Creative brief','brief','settings','ghost small')}${btn(primary[0],primary[1],primary[2],'primary',busy()?'disabled':'')}</div></div><nav class="steps" aria-label="Writing workflow">${steps.map(([t,label],i)=>`${i?'<span class="step-rule"></span>':''}<button class="step ${state.tab===t?'active':progressDone(t)?'done':''}" data-action="tab" data-tab="${t}" ${state.tab===t?'aria-current="step"':''}><span>${progressDone(t)&&state.tab!==t?'✓':i+1}</span>${label}</button>`).join('')}</nav><div id="job-slot"></div><div class="workspace-body">${({sources:sourcesHTML,graph:graphHTML,angles:anglesHTML,outline:outlineHTML,write:writeHTML}[state.tab])()}</div>`;
}
function empty(title,text,button,act,ic='spark'){return `<div class="panel"><div class="empty">${icon(ic)}<h2>${esc(title)}</h2><p>${esc(text)}</p><div class="empty-actions">${btn(button,act,ic,'primary',busy()?'disabled':'')}</div></div></div>`;}
function sourcesHTML(){const p=state.p;return `<div class="toolbar"><div><h2 class="section-title">Source library <span class="muted">${p.sources.length.toString().padStart(2,'0')}</span></h2><p class="section-desc">Original passages remain attached to the ideas extracted from them.</p></div><div class="row">${btn('Paste text','paste','file','small')}${btn('Add URL','url','link','small')}</div></div><div class="dropzone" id="dropzone" role="button" tabindex="0" data-action="upload"><div class="upload-circle">${icon('upload')}</div><strong>Drop your sources here</strong><p>or choose files · PDF, Word, Markdown, text, HTML · up to 20 MB each</p><span class="tiny muted">Documents stay on this device until you explicitly run an AI action.</span></div><div class="source-grid mt20">${p.sources.map(s=>`<article class="source-card ${!s.enabled?'disabled':''}"><div class="source-top"><span class="doc-icon">${icon(s.role==='canon'?'book':'file')}</span><div class="spacer"><span class="tiny muted">${esc(s.id)} · ${esc(s.kind.toUpperCase())}</span><h3>${esc(s.title)}</h3></div>${ibtn('Read source','source','eye',`data-id="${esc(s.id)}"`)}</div><p class="excerpt">${esc(s.text.slice(0,200))}${s.text.length>200?'…':''}</p><div class="source-bottom"><span class="chip ${s.role==='canon'?'gold':''}">${esc(s.role)}</span><span>${fmt(words(s.text))} words</span><button class="text-link" data-action="source-toggle" data-id="${esc(s.id)}">${s.enabled?'Enabled':'Excluded'}</button></div>${s.warnings.length?`<div class="notice">${esc(s.warnings.join(' '))}</div>`:''}</article>`).join('')}</div><div class="row mt20 wrap">${btn('Build knowledge graph','run-graph','graph','primary',busy()?'disabled':'')}${btn('Import existing graph','import-graph','upload','ghost small')}<span class="tiny muted">${p.mode==='fiction'?'Fiction can start from a premise and canon in the Creative brief.':'Graph extraction reads every enabled source chunk, within the job budget.'}</span></div>`;}
