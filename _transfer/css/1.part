input[type=range]{width:100%;accent-color:var(--accent);height:5px;border:0;padding:0;background:var(--border);cursor:pointer}.range-ends{font-size:9px;color:var(--soft);display:flex;justify-content:space-between;margin-top:8px}.hint{color:var(--muted);font-size:11px;line-height:1.7}.pin-list{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.pin{background:var(--hover);color:var(--accent);border:1px solid var(--border);border-radius:5px;padding:4px 7px;font-size:10px}.evidence-card{padding:12px;background:var(--bg);border-radius:8px;margin-top:12px;font-size:12px}.evidence-card blockquote{border-left:2px solid var(--soft);padding-left:10px;margin:8px 0;color:var(--muted);font:13px/1.6 var(--serif)}.text-link{background:none;padding:0;color:var(--accent);font-size:11px;text-align:left}.text-link:hover{text-decoration:underline}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.section-title{font-size:19px}.section-desc{font-size:12px;color:var(--muted);margin-top:5px}.source-grid{display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr))}.source-card{padding:19px;min-height:192px;display:flex;flex-direction:column;transition:.2s}.source-card:hover{border-color:var(--soft)}.source-card.disabled{opacity:.48}.source-top{display:flex;gap:12px;align-items:flex-start}.doc-icon{width:34px;height:39px;border:1px solid var(--border);border-radius:6px;display:grid;place-items:center;flex-shrink:0;color:var(--accent);background:var(--panel2)}.source-card h3{font-size:14px;margin-bottom:5px;letter-spacing:-.02em}.source-card .excerpt{font-size:11px;color:var(--muted);margin:13px 0 16px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;line-height:1.7}.source-bottom{margin-top:auto;display:flex;align-items:center;gap:8px;justify-content:space-between}.dropzone{border:1px dashed var(--soft);border-radius:13px;min-height:142px;display:grid;place-items:center;text-align:center;padding:25px;background:#aacb9610;cursor:pointer;margin-bottom:18px;transition:.2s}.dropzone.drag{border-color:var(--accent);background:#aacb9625}.dropzone .upload-circle{margin:0 auto 10px;display:grid;place-items:center;width:35px;height:35px;border-radius:50%;background:var(--panel2);color:var(--accent)}.dropzone strong{font-size:13px;font-weight:500}.dropzone small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.angle-grid{display:grid;gap:14px}.angle-card{padding:22px;position:relative}.angle-card.selected{border-color:var(--accent);box-shadow:inset 3px 0 var(--accent)}.angle-card h2{font-family:var(--serif);font-size:24px;font-weight:400;letter-spacing:-.03em;margin:10px 0}.angle-card .thesis{font-size:13px;line-height:1.8;max-width:730px;color:var(--text)}.angle-card .angle-why{font-size:11px;color:var(--muted);line-height:1.7;margin:12px 0}.angle-foot{display:flex;gap:9px;align-items:center;margin-top:18px;flex-wrap:wrap}.angle-score{color:var(--gold);font-size:10px}.angle-rank{font-size:11px;color:var(--soft);font-family:var(--serif)}.angle-detail{margin-top:15px;padding-top:15px;border-top:1px solid var(--border);font-size:12px}.angle-detail p{margin-top:7px;color:var(--muted)}.question{padding:9px 0;border-bottom:1px solid var(--border);font-size:11px;color:var(--muted)}.question:last-child{border-bottom:0}.outline-list{display:grid;gap:13px}.outline-section{padding:19px}.outline-number{font:22px var(--serif);color:var(--soft);min-width:28px}.outline-section input.section-heading{background:transparent;border:0;font-size:17px;letter-spacing:-.02em;padding:0;border-radius:0;width:100%}.outline-section textarea{font-size:12px;line-height:1.65;min-height:62px}.outline-section .beats{min-height:85px;background:transparent}.outline-fields{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:15px 0 0 38px}.outline-foot{margin:14px 0 0 38px;display:flex;align-items:center;gap:12px}.words-input{width:85px;padding:6px 8px;font-size:11px}.writing-layout{display:grid;grid-template-columns:minmax(0,1fr) 282px;gap:20px;align-items:start}.editor-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border)}.segmented{display:flex;background:var(--bg);padding:3px;border-radius:7px;gap:2px}.segmented button{color:var(--muted);background:none;padding:6px 11px;border-radius:5px;font-size:10px}.segmented button.active{background:var(--panel2);color:var(--text)}.editor-area{display:grid;grid-template-columns:1fr;min-height:520px}.editor-area.split{grid-template-columns:1fr 1fr}.manuscript{width:100%;resize:none;border:0;background:transparent;border-radius:0;padding:30px 34px;font:16px/1.85 var(--serif);min-height:560px;outline:none!important;color:var(--text);tab-size:2}.editor-area.split .manuscript{font-size:14px;padding:25px 23px;border-right:1px solid var(--border)}.prose{padding:30px 34px;font:16px/1.9 var(--serif);overflow-wrap:anywhere}.prose h1{font:32px/1.18 var(--serif);margin-bottom:24px}.prose h2{font:22px/1.3 var(--serif);margin:28px 0 15px}.prose h3{font:18px/1.3 var(--serif);margin:20px 0 12px}.prose p{margin:0 0 18px}.prose hr{border:0;border-top:1px solid var(--border);margin:25px 0}.prose .citation{font:10px var(--font);color:var(--accent);background:#bdd4a712;border-radius:3px;border:0;padding:2px 3px;vertical-align:super;cursor:pointer}.editor-foot{padding:10px 15px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--border);font-size:10px;color:var(--muted)}.review-issue{border-top:1px solid var(--border);padding:14px 0;font-size:11px}.review-issue:first-child{border:0}.review-issue p{margin-top:7px;line-height:1.75;color:var(--muted)}.review-issue blockquote{font:13px/1.6 var(--serif);margin:9px 0;padding-left:10px;border-left:2px solid var(--border)}.review-issue .severity{font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--gold)}.review-issue .critical{color:var(--red)}.job-bar{margin:0 34px 20px;background:var(--panel2);border:1px solid var(--border);padding:13px 16px;border-radius:10px}.progress{height:3px;background:var(--border);border-radius:3px;margin-top:11px;overflow:hidden}.progress i{display:block;height:100%;background:var(--accent);transition:width .4s}.job-message{font-size:12px}.job-usage{font-size:10px;color:var(--muted);margin-top:3px}.loader{width:17px;height:17px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite;display:inline-block;flex-shrink:0}@keyframes spin{to{transform:rotate(360deg)}}.boot{height:100vh;display:flex;align-items:center;justify-content:center;gap:12px;color:var(--muted)}.empty{padding:50px 25px;text-align:center;max-width:600px;margin:auto}.empty .icon{width:35px;height:35px;margin:0 auto 20px;color:var(--accent)}.empty h2{font-family:var(--serif);font-weight:400;font-size:28px;margin-bottom:13px}.empty p{color:var(--muted);font-size:12px;line-height:1.8;max-width:420px;margin:0 auto 24px}.empty-actions{display:flex;justify-content:center;gap:10px}.notice{border-left:2px solid var(--gold);background:#d6bd8b09;color:var(--muted);padding:11px 13px;font-size:11px;line-height:1.7;margin-top:14px;border-radius:0 6px 6px 0}.welcome{max-width:950px;padding:65px 44px;margin:auto}.welcome h1{font:51px/1.1 var(--serif);letter-spacing:-.045em;max-width:640px;margin:20px 0}.welcome>p{color:var(--muted);font-size:15px;line-height:1.85;max-width:580px}.welcome-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:35px}.welcome-card{text-align:left;padding:28px;color:var(--text);transition:.2s}.welcome-card:hover{border-color:var(--accent);transform:translateY(-2px)}.welcome-card .icon{width:27px;height:27px;color:var(--accent);margin-bottom:23px}.welcome-card h3{font:25px var(--serif);margin-bottom:10px}.welcome-card p{font-size:12px;color:var(--muted);line-height:1.8}.welcome-end{display:flex;align-items:center;gap:18px;margin-top:25px;font-size:12px;color:var(--muted)}.modal-backdrop{position:fixed;inset:0;background:#0009;backdrop-filter:blur(5px);z-index:50;display:flex;align-items:center;justify-content:center;padding:25px}.modal{background:var(--panel);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);width:650px;max-width:100%;max-height:90vh;overflow:auto}.modal.wide{width:900px}.modal-head{padding:22px 25px 19px;display:flex;align-items:flex-start;justify-content:space-between;border-bottom:1px solid var(--border);gap:15px}.modal-head h2{font-size:21px}.modal-head p{font-size:12px;color:var(--muted);margin-top:5px}.modal-body{padding:24px 25px}.modal-foot{padding:17px 25px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:flex-end;gap:10px;position:sticky;bottom:0;background:var(--panel)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}.form-grid input,.form-grid select{width:100%}.form-full{grid-column:1/-1}.checkbox-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;font-size:12px;color:var(--muted)}.checkbox-row input{accent-color:var(--accent);margin-top:4px}.checkbox-row strong{color:var(--text);font-weight:500}.modal details{border-top:1px solid var(--border);padding:15px 0}.modal summary{cursor:pointer;color:var(--text);font-size:12px}.modal .long-text{min-height:250px;font-size:12px;line-height:1.8}