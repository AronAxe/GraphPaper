function directionHTML(){const p=state.p,b=p.brief;const n=p.graph.nodes.find(n=>n.id===state.node),e=p.graph.edges.find(e=>e.id===state.edge);const selected=n||e;return `<aside class="panel direction-panel"><div class="panel-header"><h2 class="section-title">Your direction</h2>${ibtn('Edit full creative brief','brief','settings')}</div><div class="panel-body"><label class="direction-label" for="direction">What should this piece explore?</label><textarea id="direction" data-brief="direction" rows="4" placeholder="An unexpected connection, a question, a feeling…" ${busy()?'disabled':''}>${esc(b.direction)}</textarea><div class="range-row"><label for="originality">Exploration</label><span id="originality-value">${b.originality}%</span></div><input id="originality" data-brief="originality" type="range" min="0" max="100" value="${b.originality}" ${busy()?'disabled':''}><div class="range-ends"><span>Familiar ground</span><span>Unexpected bridges</span></div><div class="range-row"><label for="rigor">${p.mode==='fiction'?'Canon discipline':'Evidence discipline'}</label><span id="rigor-value">${b.rigor}%</span></div><input id="rigor" data-brief="rigor" type="range" min="0" max="100" value="${b.rigor}" ${busy()?'disabled':''}><p class="hint">${p.mode==='fiction'?'Invent freely. Treat established canon as a constraint unless you explicitly change it.':'A surprising connection is an invitation to investigate—not evidence of causation.'}</p>${b.pinned_nodes.length?`<div class="caps mt20">Pinned ideas</div><div class="pin-list">${b.pinned_nodes.map(id=>`<button class="pin" data-action="unpin" data-id="${esc(id)}">${icon('pin')}${esc(p.graph.nodes.find(n=>n.id===id)?.label||id)} ×</button>`).join('')}</div>`:''}${b.excluded_nodes.length?`<div class="mt12 tiny muted">${b.excluded_nodes.length} excluded ${btn('Reset exclusions','clear-exclusions','','small ghost')}</div>`:''}${selected?`<div class="evidence-card mt20"><div class="caps">${n?esc(n.kind):'Relationship'}</div><h3>${esc(n?n.label:e.relation.replaceAll('_',' '))}</h3><p class="small muted">${esc(selected.description)}</p><span class="chip ${selected.status==='sourced'?'green':'gold'}">${esc(selected.status)}</span>${(selected.evidence||[]).map((ev,i)=>`<blockquote>${esc(ev.quote)}</blockquote><button class="text-link" data-action="evidence" data-index="${i}">${esc(ev.source_id)} · ${ev.verified?'Exact source match':'Unverified anchor'} ${icon('chevron')}</button>`).join('')||'<p class="hint">No verified source anchor. Inspect the original before relying on this relationship.</p>'}${n?`<div class="row mt12 wrap">${btn(b.pinned_nodes.includes(n.id)?'Unpin':'Pin idea',b.pinned_nodes.includes(n.id)?'unpin':'pin','pin','small',`data-id="${esc(n.id)}"`)}${btn(b.excluded_nodes.includes(n.id)?'Include':'Exclude','exclude','','small ghost',`data-id="${esc(n.id)}"`)}</div>`:''}</div>`:`<div class="evidence-card mt20"><span class="caps">Follow the thread</span><p class="hint">Select a node or relationship to inspect its source. Drag to rearrange. Scroll to zoom.</p></div>`}</div></aside>`;}
function graphHTML(){const p=state.p;if(!p.graph.nodes.length)return empty('Start with a connection.','Upload sources or, for fiction, write a premise in your Creative brief. Then extract the graph.','Build graph','run-graph','graph');return `<div class="two-pane"><div><div class="panel graph-panel"><div class="graph-bar"><div class="graph-search">${icon('search')}<input id="graph-search" aria-label="Find an idea in the graph" placeholder="Find an idea…" value="${esc(state.search)}"></div><div class="graph-controls">${ibtn('Zoom in','zoom-in','plus')}${ibtn('Zoom out','zoom-out','minus')}${ibtn('Fit graph','fit-graph','expand')}${ibtn('Find a path','find-path','branch')}</div></div><svg class="graph-canvas" id="graph-svg" viewBox="0 0 900 590" role="img" aria-label="Interactive knowledge graph"></svg><div class="graph-footer"><div class="legend"><span><i style="background:var(--accent)"></i>Idea</span><span><i style="background:var(--blue)"></i>Claim / character</span><span><i style="background:var(--gold)"></i>Tension / event</span></div><span class="muted">Drag to explore · scroll to zoom</span></div></div><div class="toolbar mt12"><span class="tiny muted">${p.graph.nodes.length} nodes · ${p.graph.edges.length} relationships · ${esc(p.graph.engine||'native')}<span id="graph-visibility"></span></span><div class="row">${btn('Rebuild','run-graph','refresh','small ghost',busy()?'disabled':'')}${btn('Import','import-graph','upload','small ghost')}</div></div>${p.graph.warnings.slice(0,3).map(w=>`<div class="notice">${esc(w)}</div>`).join('')}${state.path.length?`<div class="notice">Conceptual path: ${state.path.map(id=>esc(p.graph.nodes.find(n=>n.id===id)?.label||id)).join(' → ')}. This path does not establish causation.</div>`:''}</div>${directionHTML()}</div>`;}
function anglesHTML(){const p=state.p;if(!p.angles.length)return empty('A graph is a possibility space.','Discover several distinct arguments or story premises, then choose or write the one you actually want.','Discover angles','run-angles')+'<div class="row mt20">'+btn('Write your own angle','custom-angle','pen','ghost')+'</div>';return `<div class="toolbar"><div><h2 class="section-title">Possible directions</h2><p class="section-desc">${p.selected_angle?'A direction is selected. Edit it freely before outlining.':'Choose a direction—or bring your own.'}</p></div><div class="row">${btn('Your own angle','custom-angle','plus','small')}${btn('Explore again','run-angles','refresh','small',busy()?'disabled':'')}</div></div><div class="two-pane"><div class="angle-grid">${p.angles.map((a,i)=>`<article class="angle-card ${a.id===p.selected_angle?'selected':''}"><div class="row between"><span class="angle-rank">DIRECTION ${String(i+1).padStart(2,'0')}</span><span class="chip ${a.id===p.selected_angle?'green':''}">${esc(a.motif||'Author direction')}</span></div><h2>${esc(a.title)}</h2><p class="thesis">${esc(a.thesis)}</p><p class="angle-why">${esc(a.why)}</p>${a.decision&&a.decision!=='unscored'?`<div class="tiny muted mt12">${esc(a.decision)}</div>`:''}<div class="angle-foot"><span class="angle-score">${a.score==null?'Not scored':`${Math.round(a.score)} / 100 · ${esc(a.score_engine||'editorial')}`}</span><div class="row">${ibtn('Edit angle','edit-angle','pen',`data-id="${esc(a.id)}"`)}${btn(a.id===p.selected_angle?'Selected':'Take this angle','select-angle',a.id===p.selected_angle?'check':'arrow',a.id===p.selected_angle?'small':'small primary',`data-id="${esc(a.id)}" ${busy()?'disabled':''}`)}</div></div><details class="angle-detail"><summary>Evidence & questions</summary><div class="mt12 small muted">${esc(a.counterargument||'No counterargument recorded yet.')}</div>${a.questions.map(q=>`<p class="question">${icon('help')}${esc(q)}</p>`).join('')}<div class="row wrap mt12">${a.source_ids.map(id=>btn(id,'source','file','small ghost',`data-id="${esc(id)}"`)).join('')}${a.node_ids.length?btn('Show in graph','angle-graph','graph','small',`data-id="${esc(a.id)}"`):''}</div>${Object.keys(a.scores).length?`<div class="mt12">${Object.entries(a.scores).map(([k,v])=>`<div class="details-line"><span>${esc(k.replaceAll('_',' '))}</span><span>${typeof v==='number'?Math.round(v*100)+'%':esc(v)}</span></div>`).join('')}<p class="tiny muted">Model estimates, not calibrated probabilities of truth.</p></div>`:''}</details></article>`).join('')}</div>${directionHTML()}</div>`;}
