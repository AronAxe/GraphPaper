 case 'find-path':{const options=p.graph.nodes.map(n=>`<option value="${esc(n.id)}">${esc(n.label)}</option>`).join('');showModal('Follow a connection','Find a conceptual path. A path is not a proof.',`<div class="form-grid"><div><label>From</label><select id="path-a">${options}</select></div><div><label>To</label><select id="path-b">${options}</select></div></div>`,btn('Find path','get-path','branch','primary'));if(p.graph.nodes.length>1)$('#path-b').selectedIndex=1;break;}
 case 'get-path':{const a=$('#path-a').value,b=$('#path-b').value,r=await api('/projects/'+p.id+'/graph/path?a='+encodeURIComponent(a)+'&b='+encodeURIComponent(b));state.path=r.path;state.node=null;closeModal();if(!r.path.length)toast('No connection was found.');render();break;}
 case 'import-graph':if(editable())chooseFile('.json',false,async files=>{await flush();const f=files[0];if(f.size>20e6)throw new Error('Graph file exceeds 20 MB.');state.p=await api('/projects/'+p.id+'/graph/import',JSON.parse(await f.text()));state.layout={};state.tab='graph';render();toast('Graph imported. Its relationships are unverified until anchored to sources.');});break;
 case 'select-angle':if(editable()){p.selected_angle=id;p.feedback.push({angle_id:id,decision:'selected',at:new Date().toISOString()});queueSave({selected_angle:id,feedback:p.feedback});await flush();render();}break;
 case 'edit-angle':if(editable())angleDialog(id);break;
 case 'custom-angle':if(editable())angleDialog();break;
 case 'save-angle':{const a={...state.editingAngle,title:$('#a-title').value,thesis:$('#a-thesis').value,hook:$('#a-hook').value,counterargument:$('#a-counter').value,questions:$('#a-questions').value.split('\n').filter(Boolean),score:null,score_engine:'author edited',scores:{},decision:'author'};if(!a.title.trim()||!a.thesis.trim())throw new Error('Give the angle a title and a thesis or premise.');const n=p.angles.findIndex(x=>x.id===a.id);if(n>=0)p.angles[n]=a;else p.angles.push(a);p.selected_angle=a.id;queueSave({angles:p.angles,selected_angle:a.id});await flush();closeModal();render();break;}
 case 'angle-graph':{const a=p.angles.find(x=>x.id===id);state.path=a.node_ids;state.node=null;state.tab='graph';render();break;}
 case 'add-section':if(editable()){p.outline.push({id:uid(),title:p.mode==='fiction'?'New scene':'New section',purpose:'',beats:[],source_ids:[],target_words:300});queueSave({outline:p.outline});render();}break;
 case 'move-section':if(editable()){const i=p.outline.findIndex(s=>s.id===id),j=i+Number(el.dataset.offset);if(j>=0&&j<p.outline.length){[p.outline[i],p.outline[j]]=[p.outline[j],p.outline[i]];queueSave({outline:p.outline});render();}}break;
 case 'remove-section':if(editable()){p.outline=p.outline.filter(s=>s.id!==id);queueSave({outline:p.outline});render();}break;
 case 'editor-view':await flush();state.view=el.dataset.view;render();break;
 case 'revise-dialog':showModal('What should change?','The current draft is saved before revision.',`<label>Editorial direction</label><textarea id="revision-instruction" rows="6" placeholder="Sharpen the central argument; preserve my voice. Or: make the character’s choice harder without changing the ending."></textarea>`,btn('Revise draft','do-revise','pen','primary'));break;
 case 'do-revise':{const text=$('#revision-instruction').value;closeModal();await startJob('revise',text);break;}
 case 'cancel-job':await api('/jobs/'+state.job.id+'/cancel',{});toast('Cancellation requested. The current provider request may still complete.');break;
 case 'dismiss-job':state.job=null;paintJob();break;
 case 'story-ledger':showModal('Continuity ledger','A generated record of what has happened—not new author-approved canon.',`<div class="source-text">${esc(JSON.stringify(p.story_state,null,2))}</div><div class="notice">Check this against the draft and your canon. It helps later scenes remember earlier developments, but remains an AI summary.</div>`,'',true);break;
 case 'versions':await versionsDialog();break;
 case 'read-version':{const r=state.versions.find(x=>x.id===id);showModal(r.label,'A saved version. Reading it does not change your manuscript.',`<article class="prose">${markdown(r.draft)}</article>`,btn('Restore this version','restore-version','clock','primary',`data-id="${esc(id)}"`),true);break;}
 case 'restore-version':if(editable()){await flush();state.p=await api('/projects/'+p.id+'/revisions/'+id+'/restore',{});closeModal();state.tab='write';render();toast('Version restored; the previous draft is preserved.');}break;
 case 'export':exportDialog();break;
 case 'export-file':await exportFile(el.dataset.kind);break;
 case 'import-project':chooseFile('.json',false,async files=>{if(files[0].size>25e6)throw new Error('Project backup exceeds 25 MB.');const p=await api('/import',JSON.parse(await files[0].text()));await setProject(p);toast('Project imported as a separate copy.');});break;
 case 'project-options':showModal('Project settings','Rename or remove this workspace.',`<label>Title</label><input id="rename-title" value="${esc(p.title)}" style="width:100%"><div class="notice">Deleting a project also removes its local draft history. Export a backup first.</div>`,btn('Delete project','delete-project','trash','ghost danger')+btn('Save title','rename-project','check','primary'));break;
 case 'rename-project':if(editable()){queueSave({title:$('#rename-title').value.slice(0,200)||'Untitled project'});await flush();closeModal();render();}break;
 case 'delete-project':if(editable()){showModal('Delete this project?','This removes the local sources, graph, draft and saved versions.',`<p>${esc(p.title)}</p><p class="hint">This cannot be undone. Export a backup first.</p>`,btn('Keep project','close-modal','','ghost')+btn('Delete permanently','confirm-delete','trash','danger'));}break;
 case 'confirm-delete':await api('/projects/'+p.id,undefined,'DELETE');state.projects=state.projects.filter(x=>x.id!==p.id);state.p=null;pending={};closeModal();render();break;
 case 'help':showModal('A studio, not an autopilot','The author keeps the decisions that matter.',`<div class="stack"><h3>1. Bring the material</h3><p class="small muted">Evidence is citable material. Canon is established fictional truth. Inspiration suggests possibilities; voice samples guide style. Keep these roles distinct.</p><h3>2. Explore before committing</h3><p class="small muted">The graph exposes claims and relationships. Exact source matches verify where a quote came from—not whether the claim is true. Imported or inferred relationships remain visibly distinct.</p><h3>3. Choose a direction</h3><p class="small muted">JEV evaluates graph opportunities, angle fit, evidence gaps and revision decisions. Its estimates are judgments, not guaranteed accuracy. You can edit or replace every angle.</p><h3>4. Shape, write, review</h3><p class="small muted">Edit the outline, generate section by section, inspect the full-draft review and revise. Fiction checks motivation and canon; nonfiction checks argument and evidence. Source references are clickable.</p><h3>5. Keep what is yours</h3><p class="small muted">Projects live locally. Model requests happen only after consent. Export Word, Markdown, print-ready HTML, graph JSON or a project backup. Settings and API keys never appear in backups.</p></div><div class="notice">GraphPaper does not automatically fact-check the web or prove that a source supports a conclusion. Read the linked passages. There is no promise that adding a graph will outperform a strong direct-writing prompt on every task.</div>`,'',true);break;
 }
}
document.addEventListener('click',e=>{const el=e.target.closest('[data-action]');if(!el||el.disabled)return;e.preventDefault();handleAction(el).catch(err=>{if($('.modal'))modalError(err.message);else toast(err.message,true);});});
document.addEventListener('input',e=>{const el=e.target;if(el.id==='graph-search'){state.search=el.value;drawGraph();return;}if(el.id==='manuscript'){if(busy())return;state.p.draft=el.value;queueSave({draft:el.value});if($('#draft-preview'))$('#draft-preview').innerHTML=markdown(el.value);$('#word-count').textContent=fmt(words(el.value))+' words · target '+fmt(state.p.brief.target_words);return;}if(el.dataset.brief){if(busy())return;const key=el.dataset.brief;state.p.brief[key]=['originality','rigor'].includes(key)?Number(el.value):el.value;if($('#'+key+'-value'))$('#'+key+'-value').textContent=el.value+'%';queueSave({brief:{...state.p.brief}});return;}if(el.dataset.outline){if(busy())return;const s=state.p.outline.find(s=>s.id===el.dataset.id),k=el.dataset.outline;if(k==='target_words'){const n=Number(el.value);if(n<50||n>5000)return;s[k]=n;}else s[k]=k==='beats'?el.value.split('\n').filter(Boolean):el.value;queueSave({outline:state.p.outline});}});
document.addEventListener('change',e=>{if(e.target.id==='s-provider'){const b=$('#s-base_url');b.value={openrouter:'https://openrouter.ai/api/v1','openai-compatible':'https://api.openai.com/v1',anthropic:'https://api.anthropic.com/v1'}[e.target.value];}});
