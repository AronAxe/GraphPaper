document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();flush().then(()=>toast('Saved locally.')).catch(x=>toast(x.message,true));}if(e.key==='Escape'&&$('.modal'))closeModal();if(e.key==='Tab'&&$('.modal')){const focus=$$('button:not(:disabled),input:not(:disabled),select:not(:disabled),textarea:not(:disabled),[tabindex="0"]',$('.modal')).filter(x=>x.offsetParent!==null),first=focus[0],last=focus.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}});
window.addEventListener('beforeunload',e=>{if(Object.keys(pending).length||state.save==='Saving…'){e.preventDefault();e.returnValue='';}});
async function boot(){try{const b=await api('/bootstrap');state.settings=b.settings;state.projects=b.projects;const id=storage.getItem('graphpaper.last');if(id&&b.projects.some(p=>p.id===id)){state.p=await api('/projects/'+id);state.tab=state.p.graph.nodes.length?'graph':'sources';state.job=b.jobs.find(j=>j.project_id===id)||null;if(state.job)poll();}render();}catch(e){$('#app').innerHTML=`<div class="empty"><h2>The studio couldn’t open.</h2><p>${esc(e.message)}</p><p>Close and reopen GraphPaper to establish a fresh local session.</p></div>`;}}
boot();

// Native close uses a save handshake, not eval (our CSP deliberately forbids it).
window.graphpaperRequestClose=async()=>{
 try{await flush();if(window.pywebview?.api?.request_close)await window.pywebview.api.request_close();}
 catch(e){toast('Not closed: '+e.message,true);}
};
function notifyDesktopReady(){window.pywebview?.api?.notify_ready?.().catch(()=>{});}
window.addEventListener('pywebviewready',notifyDesktopReady);
notifyDesktopReady();
